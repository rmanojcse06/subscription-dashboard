# Generate with: python -m app.crypto  (or, with Docker: docker compose run --rm app python -m app.crypto)
SUBDASH_MASTER_KEY=
# History and keys, never committed:
SUBDASH_DATA_DB_URL=sqlite:///./data/data.db
# Profile, accounts and widgets, committed to git:
SUBDASH_CONFIG_DB_PATH=./config/config.db
